# Example environment file for news-intelligence-engine.
# Copy to `.env` and fill in secrets as needed. Full reference: _docs/design.md §14.

# Postgres connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nie_db

# OpenAI-compatible LLM endpoint (Google AI Studio)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Google AI Studio free API key (or Groq/DeepSeek). Optional until the LLM client (issue #23) ships.
LLM_API_KEY=

# Primary model for triage and adjudication
LLM_MODEL=gemini-2.5-flash

# FastEmbed model (runs locally on CPU, 384d)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Telegram Bot API token (free instant push alerts). Optional until the Telegram notifier (issue #32) ships.
TELEGRAM_BOT_TOKEN=

# Telegram target chat / user ID. Optional until the Telegram notifier (issue #32) ships.
TELEGRAM_CHAT_ID=

# Resend API key for email delivery. Optional until the Resend notifier (issue #31) ships.
RESEND_API_KEY=

# Email recipient for notifications. Optional until the Resend notifier (issue #31) ships.
NOTIFY_EMAIL_TO=

# CSV of discovery providers: stub, rss
DISCOVERY_PROVIDERS=stub,rss

# CSV of RSS feeds (Google News Silver query + industry feeds). Optional until RssProvider (issue #17) ships.
RSS_FEEDS=

# Scheduler cadence, in minutes
POLL_INTERVAL_MINUTES=60

# Minimum importance to trigger a notification: low, medium, high, critical
NOTIFY_MIN_IMPORTANCE=medium

# Candidate recall window, in days
DEDUP_WINDOW_DAYS=14
